{
	"name": "colors-le",
	"publisher": "nolindnaidoo",
	"displayName": "Colors-LE",
	"description": "Zero Hassle Color Extraction from CSS, SCSS, LESS, Stylus, HTML, JavaScript, TypeScript, and SVG",
	"version": "2.0.1",
	"license": "MIT",
	"author": {
		"name": "nolindnaidoo",
		"url": "https://github.com/nolindnaidoo"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nolindnaidoo/colors-le.git"
	},
	"bugs": {
		"url": "https://github.com/nolindnaidoo/colors-le/issues"
	},
	"homepage": "https://letools.dev",
	"engines": {
		"vscode": "^1.90.0",
		"node": ">=20.0.0"
	},
	"categories": [
		"Other",
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"colors",
		"color",
		"extract",
		"extraction",
		"palette",
		"hex",
		"rgb",
		"hsl",
		"css",
		"scss",
		"less",
		"stylus",
		"html",
		"javascript",
		"typescript",
		"svg"
	],
	"icon": "src/assets/images/icon.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:css",
		"onLanguage:scss",
		"onLanguage:less",
		"onLanguage:stylus",
		"onLanguage:html",
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:xml"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "colors-le.extractColors",
				"title": "%manifest.command.extract.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.analyze",
				"title": "%manifest.command.analyze.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.convert",
				"title": "%manifest.command.convert.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.filter",
				"title": "%manifest.command.filter.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.validate",
				"title": "%manifest.command.validate.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.postProcess.dedupe",
				"title": "%manifest.command.dedupe.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.postProcess.sort",
				"title": "%manifest.command.sort.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.openSettings",
				"title": "%manifest.command.settings.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "colors-le.help",
				"title": "%manifest.command.help.title%",
				"category": "%manifest.command.category%"
			}
		],
		"keybindings": [
			{
				"command": "colors-le.extractColors",
				"key": "ctrl+alt+c",
				"mac": "cmd+alt+c",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "colors-le.extractColors",
					"when": "editorLangId =~ /^(css|scss|less|stylus|html|javascript|javascriptreact|typescript|typescriptreact|xml)$/",
					"group": "1_modification@1"
				}
			],
			"commandPalette": [
				{
					"command": "colors-le.extractColors"
				},
				{
					"command": "colors-le.analyze"
				},
				{
					"command": "colors-le.convert"
				},
				{
					"command": "colors-le.filter"
				},
				{
					"command": "colors-le.validate"
				},
				{
					"command": "colors-le.postProcess.dedupe"
				},
				{
					"command": "colors-le.postProcess.sort"
				},
				{
					"command": "colors-le.openSettings"
				},
				{
					"command": "colors-le.help"
				}
			]
		},
		"configuration": {
			"title": "%manifest.settings.title%",
			"properties": {
				"colors-le.copyToClipboardEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.copy.clipboard.desc%"
				},
				"colors-le.dedupeEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.dedupe.desc%"
				},
				"colors-le.notificationsLevel": {
					"type": "string",
					"default": "silent",
					"enum": [
						"all",
						"important",
						"silent"
					],
					"enumDescriptions": [
						"%manifest.settings.notifications.level.option.all%",
						"%manifest.settings.notifications.level.option.important%",
						"%manifest.settings.notifications.level.option.silent%"
					],
					"description": "%manifest.settings.notifications.level.desc%"
				},
				"colors-le.openResultsSideBySide": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.open.side-by-side.desc%"
				},
				"colors-le.safety.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.safety.enabled.desc%"
				},
				"colors-le.safety.fileSizeWarnBytes": {
					"type": "number",
					"default": 1000000,
					"minimum": 1000,
					"description": "%manifest.settings.safety.warn.file-size.desc%"
				},
				"colors-le.safety.largeOutputLinesThreshold": {
					"type": "number",
					"default": 50000,
					"minimum": 100,
					"description": "%manifest.settings.safety.warn.large-output.desc%"
				},
				"colors-le.sortMode": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"hue-asc",
						"hue-desc",
						"saturation-asc",
						"saturation-desc",
						"lightness-asc",
						"lightness-desc",
						"hex-asc",
						"hex-desc"
					],
					"enumDescriptions": [
						"%manifest.settings.sort.mode.option.off%",
						"%manifest.settings.sort.mode.option.hue-asc%",
						"%manifest.settings.sort.mode.option.hue-desc%",
						"%manifest.settings.sort.mode.option.saturation-asc%",
						"%manifest.settings.sort.mode.option.saturation-desc%",
						"%manifest.settings.sort.mode.option.lightness-asc%",
						"%manifest.settings.sort.mode.option.lightness-desc%",
						"%manifest.settings.sort.mode.option.hex-asc%",
						"%manifest.settings.sort.mode.option.hex-desc%"
					],
					"description": "%manifest.settings.sort.mode.desc%"
				},
				"colors-le.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.statusbar.enabled.desc%"
				},
				"colors-le.telemetryEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.telemetry.desc%"
				}
			}
		}
	},
	"scripts": {
		"clean": "node -e \"const fs=require('fs');['dist','coverage','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
		"clean:i18n": "node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.startsWith('package.nls.')&&f.endsWith('.json')&&f!=='package.nls.json').forEach(f=>fs.unlinkSync(f))\"",
		"copy:i18n": "node -e \"const fs=require('fs');fs.readdirSync('src/i18n').forEach(f=>fs.copyFileSync('src/i18n/'+f,f))\"",
		"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap",
		"build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --minify --sourcemap=external",
		"watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"check:bundle": "node scripts/check-bundle.js",
		"test": "vitest run --pool=threads",
		"test:watch": "vitest --pool=threads",
		"test:coverage": "vitest run --coverage --pool=threads",
		"test:integration": "npm run build && tsc -p tsconfig.it.json && vscode-test",
		"test:e2e-vsix": "node scripts/e2e-vsix.js",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"vscode:prepublish": "npm run typecheck && npm run build:prod && npm run check:bundle && npm run copy:i18n",
		"package": "node -e \"require('fs').mkdirSync('release',{recursive:true})\" && vsce package --out release/ && npm run clean:i18n",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.7.1",
		"@types/vscode": "^1.90.0",
		"@vitest/coverage-v8": "^3.2.4",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.6.2",
		"esbuild": "^0.28.1",
		"mocha": "^11.7.6",
		"ovsx": "^1.0.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
